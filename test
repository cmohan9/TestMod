<QueryList>
  <Query Id="0" Path="Security">
    <Select Path="Security">
      *[System[(EventID=4624 or EventID=4625)]]
      and
      *[EventData[Data[@Name='TargetUserName']='JP-Notes-Sched']]
    </Select>
  </Query>
</QueryList>

<QueryList>
  <Query Id="0" Path="Security">
    <Select Path="Security">
      *[System[(EventID=4624 or EventID=4625) and TimeCreated[@SystemTime&gt;='2026-10-03T23:25:00.000Z' and @SystemTime&lt;='2026-10-03T23:35:00.000Z']]]
      and
      *[EventData[Data[@Name='TargetUserName']='JP-Notes-Sched']]
    </Select>
  </Query>
</QueryList>



<QueryList>
  <Query Id="0" Path="Microsoft-Windows-TaskScheduler/Operational">
    <Select Path="Microsoft-Windows-TaskScheduler/Operational">
      *[System[(EventID=100 or EventID=101 or EventID=102 or EventID=103 or EventID=106 or EventID=129 or EventID=200 or EventID=201 or EventID=203)]]
    </Select>
  </Query>
</QueryList>



<QueryList>
  <Query Id="0" Path="Microsoft-Windows-TaskScheduler/Operational">
    <Select Path="Microsoft-Windows-TaskScheduler/Operational">
      *[System[EventID=129]] and *[EventData[Data[@Name='TaskName']='\(periodic)shutdown']]
    </Select>
  </Query>
</QueryList>
